# Optional server-side defaults. All of these are OPTIONAL.
# When set, they act as a fallback/override for the client-supplied configuration
# so that secrets never have to live in the browser.

# Default n8n webhook URL used when the client does not supply one.
# N8N_WEBHOOK_URL=https://example.app.n8n.cloud/webhook/ai-agent

# Default approval (human-in-the-loop) webhook URL.
# N8N_APPROVAL_WEBHOOK_URL=https://example.app.n8n.cloud/webhook/ai-agent-approval

# Server-side API key. When set it is injected into the outgoing request and the
# browser never sees it. Takes precedence over a client-supplied key.
# N8N_API_KEY=

# Header name used to send the API key. Default: Authorization
# N8N_API_KEY_HEADER=Authorization

# Prefix prepended to the API key value. Default: "Bearer "
# N8N_API_KEY_PREFIX=Bearer

# Request timeout in milliseconds. Default: 60000
# N8N_TIMEOUT_MS=60000

# When "true", the server refuses any webhook URL supplied by the browser and
# only uses N8N_WEBHOOK_URL. Recommended for production deployments.
# N8N_LOCK_WEBHOOK=false
